{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KCD Hukuk",
  "mainBinaryName": "kcd-hukuk",
  "version": "3.0.5",
  "identifier": "tr.av.kolancoskuner.kcdhukuk",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "local",
        "remote"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Kolan Coşkuner Doğan Hukuk Bürosu",
    "copyright": "© Kolan Coşkuner Doğan Hukuk Bürosu",
    "category": "Productivity",
    "shortDescription": "KCD Hukuk",
    "longDescription": "KCD Hukuk masaüstü uygulaması: KCD Hukuk'u Claude çubukları olmadan açar ve kendini günceller.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRTg1RDY1MDQ3OUFDOUYKUldTZnJIa0VaVjNvVW8yQldhaUtSc2o0UGU2SU8yT0wxblI5RlR1U1FqQ0RyanRZUGphS3llcE8K",
      "endpoints": [
        "https://github.com/udaykalkal/kcd-hukuk-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}